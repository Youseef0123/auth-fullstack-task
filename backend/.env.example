NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/auth-fullstack-task

# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duration with a unit: s, m, h or d (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1d

# Frontend origin allowed to send credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# Rate limit for sign up / sign in: max THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=5

# Which proxies may set X-Forwarded-For (drives req.ip and therefore rate limiting):
# "false" (none), "loopback" (same host), a hop count such as "1", or a
# comma-separated list of IPs/CIDRs. Never trust all.
# Behind the Next.js frontend: its /api rewrite forwards the client's headers
# unchanged and adds no X-Forwarded-For. Put a reverse proxy in front of Next.js
# that sets it (overwrite, or append like nginx $proxy_add_x_forwarded_for), keep
# Next.js and this API unreachable from outside, and trust only the Next.js hop:
# "loopback" on the same host, otherwise its IP/CIDR. Without that proxy, all
# browsers share the Next.js server's address and a client-sent header is trusted.
TRUST_PROXY=loopback
