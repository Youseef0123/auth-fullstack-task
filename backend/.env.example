NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/auth-fullstack-task

# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duration with a unit: s, m, h or d (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1d

# Frontend origin allowed to send credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# Rate limit for sign up / sign in: max THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP.
# 20 for local dev (all browsers share one bucket behind Next.js); the default and Docker use 5.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Proxies allowed to set X-Forwarded-For: keep "false" locally (also the default).
# Why, and what production needs: README.md, "Rate limiting and TRUST_PROXY".
TRUST_PROXY=false
