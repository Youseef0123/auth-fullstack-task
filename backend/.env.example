NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/auth-fullstack-task

# Required, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duration with a unit: s, m, h or d (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1d

# Frontend origin allowed to send credentialed (cookie) requests
CORS_ORIGIN=http://localhost:3000

# Rate limit for sign up / sign in: max THROTTLE_LIMIT requests per THROTTLE_TTL_MS per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=5

# Which proxies may set X-Forwarded-For (drives req.ip and therefore rate limiting):
# "false" (none), "loopback" (same host), a hop count such as "1", or a
# comma-separated list of IPs/CIDRs. Never trust all.
# Local dev keeps "false": the Next.js /api rewrite adds no X-Forwarded-For and
# passes a client-sent one through unchanged, so trusting it would let a client
# pick a fresh rate-limit bucket per request. With "false" the header is ignored
# and all browsers share the Next.js server's bucket: stricter, never bypassable.
# Production: put a reverse proxy in front that OVERWRITES X-Forwarded-For with
# the real client IP, keep Next.js and this API reachable only through it, and
# trust only the hops between that proxy and this API (e.g. the Next.js server's
# IP/CIDR, or "loopback" when it runs on the same host).
TRUST_PROXY=false
