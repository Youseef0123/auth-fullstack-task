# Copy to .env.local.

# Origin of the NestJS API (no trailing /api). The Next.js server proxies /api/*
# to it (next.config.ts rewrites), so the browser only talks to this origin and
# the auth cookie stays first-party. Read by `next dev` and `next build`; the
# rewrite is compiled into the build, so set it before building.
BACKEND_URL=http://localhost:4000
